# «Двобій 3D» — налаштування Apache (Hostinger / cPanel / будь-який хостинг з .htaccess)
Options -Indexes
DirectoryIndex index.html

<IfModule mod_mime.c>
  AddType application/json .json
  AddType model/gltf-binary .glb
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml .svg
  AddType text/javascript .js .mjs
  AddCharset utf-8 .html .js .json .css .md
</IfModule>

# Стиснення
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Кеш: бібліотеки й моделі — надовго, сторінку — щоразу перевіряти
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType application/json "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType text/javascript "access plus 30 days"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Заголовок Authorization має доходити до PHP (вхід у акаунт)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>
<IfModule mod_setenvif.c>
  SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>

# Службові файли не віддаємо
<FilesMatch "(^\.|\.(sqlite|log|md|sh)$|^config\.php$)">
  Require all denied
</FilesMatch>
